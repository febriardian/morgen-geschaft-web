# ============================================================================
# Morgen Geschäft — Backend Environment Variables
# Copy ke .env lalu isi nilainya. JANGAN commit .env ke repository.
# ============================================================================

# ---- WAJIB: Midtrans Payment Gateway ----
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=true
# Set true saat go-live. Ini menentukan URL API Midtrans (sandbox vs production).

# ---- OPSIONAL: Midtrans Webhook IP Whitelist ----
# MIDTRANS_WEBHOOK_IPS=103.208.23.0/24,103.208.22.0/24
# Comma-separated IP atau CIDR. Jika tidak diset, semua IP diterima (hanya signature check).
# Lihat: https://docs.midtrans.com/docs/ip-address untuk daftar IP Midtrans.

# ---- WAJIB: Firebase Admin SDK ----
FIREBASE_SERVICE_ACCOUNT_BASE64=ey...
# Base64 dari file service account JSON. Cara generate:
#   base64 -w 0 firebase-service-account.json

# ---- WAJIB: Frontend URL (CORS + email links) ----
FRONTEND_URL=https://morgengeschaft.com
# Bisa comma-separated untuk multiple origins: https://morgengeschaft.com,http://localhost:5173

# ---- WAJIB: Gemini API (GESA chatbot) ----
GEMINI_API_KEY=AQ.xxxx
# Key dari Google AI Studio. Format baru diawali "AQ."

# ---- WAJIB di production: Node Environment ----
NODE_ENV=production
# PM2 menggunakan production juga di localhost. Kontrol redirect HTTPS melalui ENFORCE_HTTPS.

# ---- OPSIONAL: Server Port ----
PORT=3002

# ---- OPSIONAL: Trust Proxy ----
# Rumahweb/cPanel dengan satu reverse proxy: TRUST_PROXY=1
# Local direct Node tanpa reverse proxy: TRUST_PROXY=false
TRUST_PROXY=1

# HTTPS enforcement
# Localhost gunakan false. Domain production dengan SSL gunakan true.
ENFORCE_HTTPS=true
# Set ke jumlah layer proxy (1 untuk Nginx langsung, 2 untuk Cloudflare+Nginx).
# Atau 'loopback' jika proxy di localhost. Tanpa ini, req.ip = IP proxy, bukan client.


# ---- OPSIONAL SEKARANG, WAJIB SEBELUM PM2 CLUSTER: Upstash Redis Rate Limiter ----
# Gunakan "memory" selama development lokal tanpa Redis.
# Ubah menjadi "redis" setelah kredensial REST Upstash tersedia.
RATE_LIMIT_STORE=memory

# Jumlah worker PM2 cluster. Dipakai HANYA untuk fallback in-memory (saat Redis
# mati) agar batas per-worker dibagi rata. Default 1 (fork/single). Set = jumlah
# instances di ecosystem.config.cjs jika memakai cluster.
RATE_LIMIT_CLUSTER_INSTANCES=1

# Salin dari Upstash Console > database > REST API.
# URL harus https://... dan token harus disimpan sebagai rahasia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_TIMEOUT_MS=5000
# REDIS_CONNECT_TIMEOUT_MS: fallback lama untuk timeout koneksi Redis (default 5000).
# Dipakai hanya jika UPSTASH_REDIS_REST_TIMEOUT_MS tidak diset.
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_RETRY_COOLDOWN_MS=30000
RATE_LIMIT_REDIS_PREFIX=morgen:rate-limit

# Kompatibilitas sementara: REDIS_URL rediss:// lama masih dapat dikonversi
# otomatis ke REST, tetapi variabel REST di atas lebih disarankan.
REDIS_URL=

# ---- OPSIONAL: Payment Expiry ----
PAYMENT_EXPIRY_MINUTES=60
# Rentang valid: 5 — 10080 (7 hari). Default: 15.

FIRESTORE_BACKUP_RETENTION_DAYS=30

# ---- Email (SMTP) — DISARANKAN layanan transaksional untuk invoice ----
# Gmail rawan masuk spam & limit ~500/hari. Untuk toko, pakai layanan email
# transaksional. Kode hanya butuh SMTP standar, jadi tinggal ganti nilai di bawah.
# Panduan lengkap + setup SPF/DKIM domain: lihat docs/README.md bagian SMTP
#
# Contoh Brevo (gratis 300 email/hari):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<login SMTP dari dashboard Brevo, mis. 8xxxxx@smtp-brevo.com>
#   SMTP_PASS=<SMTP key dari Brevo>
# Contoh SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=<API key>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
# FROM harus pakai domain sendiri (bukan gmail) agar SPF/DKIM selaras & tidak spam:
SMTP_FROM="Morgen Geschäft" <no-reply@morgengeschaft.com>

# ---- OPSIONAL: Admin Notification Email ----
ADMIN_NOTIFICATION_EMAIL=admin@morgengeschaft.com
# Default: pakai SMTP_USER jika tidak diset.

# ---- WAJIB: Biteship Shipping ----
BITESHIP_API_KEY=biteship_live.xxx

# ---- WAJIB sebelum mengaktifkan webhook Biteship ----
# Buat string acak minimal 32 karakter. Pasang nilai yang sama pada konfigurasi
# authentication webhook Biteship. Jika dashboard tidak menyediakan header,
# endpoint juga menerima query ?token=... sebagai fallback.
BITESHIP_WEBHOOK_SECRET=ganti-dengan-random-minimal-32-karakter

# ---- WAJIB: Signature quote ongkir ----
SHIPPING_QUOTE_SECRET=ganti-dengan-random-minimal-32-karakter
# Gunakan nilai acak yang berbeda dari Midtrans server key.

# ---- WAJIB: keamanan akun pelanggan, OTP, referral, dan token pesanan ----
CUSTOMER_AUTH_SECRET=ganti-dengan-random-minimal-64-karakter
# Buat nilai berbeda dari seluruh key lain. Contoh PowerShell:
# [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))

# Aktifkan hanya setelah TOTP sudah didaftarkan, login kedua berhasil,
# dan `npm run admin:mfa -- doctor email@domain.com` menyatakan ready=true.
REQUIRE_ADMIN_MFA=true

# ---- OPSIONAL: Web Push (VAPID) ----
VAPID_PUBLIC_KEY=BxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxE
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Generate: npx web-push generate-vapid-keys

# ---- OPSIONAL: Invoice Logo ----
INVOICE_LOGO_PATH=./public/photos/logo-512.png
INVOICE_LOGO_URL=https://morgengeschaft.com/photos/logo-512.png
# Salah satu saja. INVOICE_LOGO_PATH dicek duluan.

# ---- WAJIB untuk deployment satu domain ----
SERVE_FRONTEND=true

# ---- OPSIONAL: Upload Directory ----
UPLOAD_DIR=./storage/uploads
# Default: ./storage/uploads di working directory.

# ---- OPSIONAL: Public Site URL (untuk sitemap, SEO) ----
PUBLIC_SITE_URL=https://morgengeschaft.com

# ---- OPSIONAL: WhatsApp CS ----
STORE_WHATSAPP=6289601725019

# ---- OPSIONAL: WhatsApp Notification (Fonnte) ----
FONNTE_TOKEN=
# Dari dashboard fonnte.com. Jika kosong, WhatsApp notification dilewati.
ADMIN_WHATSAPP=6289601725019
# Nomor WA admin untuk notif pesanan baru. Default: STORE_WHATSAPP.

# ---- OPSIONAL: Sentry Error Monitoring ----
SENTRY_DSN=
# Dari Sentry > Project Settings > Client Keys. Jika kosong, Sentry dilewati.
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=morgen-geschaft@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
# Rentang sample rate 0 sampai 1. Nilai 0.1 berarti 10% transaksi dipantau.

# ---- OPSIONAL: Cloudinary Image CDN ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
# Dari Cloudinary dashboard. Jika kosong, gambar disajikan langsung dari server.

ABANDONED_CART_REMINDER_MINUTES=30
