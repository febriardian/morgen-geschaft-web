# ============================================================================
# Morgen Geschäft — Frontend Environment Variables
# Copy ke .env lalu isi nilainya.
# ============================================================================

# ---- Backend API URL ----
VITE_API_BASE=
# Kosong untuk deployment satu domain: https://morgengeschaft.com/api

# ---- Midtrans Client Key ----
VITE_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxx
VITE_MIDTRANS_IS_PRODUCTION=true
# Set false untuk sandbox. Jika VITE_MIDTRANS_CLIENT_KEY kosong, akan
# fallback ke redirect URL dari backend (tetap berfungsi tanpa Snap popup).

# ---- WAJIB: Firebase client SDK ----
VITE_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=morgen-geschaft.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=morgen-geschaft
VITE_FIREBASE_STORAGE_BUCKET=morgen-geschaft.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=196942850443
VITE_FIREBASE_APP_ID=1:196942850443:web:xxxxxxxxxxxxxxxxxxxx
# Rollout aman: biarkan false sampai Identity Platform + TOTP aktif.
# Ubah true untuk memulai enrollment dan mewajibkan MFA di frontend.
VITE_REQUIRE_ADMIN_MFA=true

VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=token_dari_sentry
SENTRY_ORG=organization-slug
SENTRY_PROJECT=project-slug
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Analytics (opsional) ----
VITE_GA_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=XXXXXXXXXX
